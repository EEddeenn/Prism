{
  "name": "prism-web",
  "version": "0.1.0",
  "private": true,
  "description": "Prism dependency-topology explorer — Next.js + React Three Fiber UI rendered statically with an in-browser WASM engine",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/prism-wasm --target web --release --out-dir ../../web/src/wasm --out-name prism_wasm && mkdir -p public/wasm && cp src/wasm/prism_wasm_bg.wasm public/wasm/prism_wasm_bg.wasm",
    "prebuild": "npm run build:wasm",
    "predev": "npm run build:wasm",
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.18.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.172.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0"
  }
}
