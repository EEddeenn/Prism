# The prism-serve JSON API the UI reads from. The browser talks to the Next.js
# app same-origin; the server-side proxy at /api/* forwards here. Default:
PRISM_API_URL=http://127.0.0.1:7831

# Optional: bypass the proxy and have the BROWSER call prism-serve directly
# (prism-serve sends open CORS headers, so this works for local use). Leave unset
# to use the same-origin proxy above.
# NEXT_PUBLIC_PRISM_API=http://127.0.0.1:7831
